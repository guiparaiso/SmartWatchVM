# ============================================
# TESTE 1: Demonstração Básica
# Testa: variáveis, expressões, SHOW
# ============================================

SHOW "=== SmartWatch Language - Demo Básico ==="

# Operações aritméticas
x = 10
y = 5
SHOW "x = 10, y = 5"

soma = x + y
SHOW "x + y ="
SHOW soma

subtracao = x - y
SHOW "x - y ="
SHOW subtracao

multiplicacao = x * 2
SHOW "x * 2 ="
SHOW multiplicacao

divisao = y / 2
SHOW "y / 2 ="
SHOW divisao

# Expressões complexas
x=10
y=5
resultado = (x + y) * 2 - 5
SHOW "(x + y) * 2 - 5 ="
SHOW resultado

# Operador unário
negativo = -x
SHOW "-x ="
SHOW negativo

SHOW "=== Teste Básico Completo ==="
HALT